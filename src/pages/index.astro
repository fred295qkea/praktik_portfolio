---
import Mainlayout from "../layouts/Mainlayout.astro";
import Header from "../components/Header.astro";
import { Image } from "astro:assets";
import Site from "../assets/Site.webp";
import Wwwolt from "../assets/wwwolt.png";
import BLDashboard from "../assets/BL_dashboard.png";
import Pageflow from "../assets/pageflow.png";
import Fooredo from "../assets/Fooredo.png";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Whitespace from "../components/Whitespace.astro";
import Link from "../components/Link.astro";
import downloadGif from "../assets/cv_download.gif";
import Mail from "../components/Mail.astro";

const skills = ["HTML & CSS", "JavaScript", "TypeScript", "React", "Next.js", "Vue", "Astro", "Tailwind CSS", "SCSS", "Shopify / Liquid", "Node.js", "Python", "Flask", "REST API'er", "SQL", "Database design", "Docker", "Prisma", "Jest", "Git", "CI/CD pipelines", "Figma", "UI & UX", "Web application security"];
---

<Mainlayout>
  <Header />

  <section class="md:grid md:grid-cols-2 md:grid-rows-2 justify-items-center items-center md:my-12">
    <h1 class="aniHero text-center text-4xl md:self-end">Frederik Jensen</h1>
    <div class="heroImg mx-10 scale-x-[-1] md:row-span-2 transition ease-linear duration-300">
      <Image src={Site} alt="Profile pic" />
    </div>

    <div class="aniHeroText text-center m-4 border-2 border-black rounded-md md:border-none md:self-start md:px-20 md:mx-20">
      <p>Web developer with professional experience in e-commerce and fullstack development, building scalable solutions for well-known brands</p>
    </div>
  </section>
  <i class="fa-solid fa-chevron-down fa-2xl down hidden place-content-center md:grid cursor-pointer"></i>

  <Whitespace size="normal" />

  <h2 class="projectText text-center text-4xl">Projekter</h2>

  <section class="projectContainer w-full flex align-stretch flex-col justify-around md:flex-row md:flex-nowrap">
    <div class="card_display p-3 m-4 md:w-fit">
      <Image src={BLDashboard} alt="BL Dashboard" />
      <h2>BL Dashboard</h2>
      <div class="flex justify-between flex-col h-full">
        <p>My bachelor project — an internal dashboard built for Black Lemon. A fullstack application with Next.js 16, React 19, Prisma and MySQL, secured with Auth0 authentication. Features data visualization with Recharts, Excel/PDF export, and Docker-based deployment.</p>
        <Link link="https://bl-dashboard-three.vercel.app/dashboard" text="Deploy!" />
      </div>
    </div>

    <div class="card_display p-3 m-4 md:w-fit">
      <Image src={Fooredo} alt="Fooredo" />
      <h2>Fooredo</h2>
      <div class="flex justify-between flex-col h-full">
        <p>A frontend project where I independently built a new version of a festival booking site. Features a DatoCMS integration and a cohesive design across both the program page and the ticket ordering flow.</p>
        <Link link="https://github.com/FrederikBNJensen/fooredo" text="Github!" />
      </div>
    </div>

    <div class="card_display p-3 m-4 md:w-fit">
      <Image src={Wwwolt} alt="WWWolt" />
      <div class="flex justify-between flex-col h-full">
        <h2>WWWolt</h2>
        <p>A fullstack group project built with Python and Flask, backed by a MySQL database. Features user authentication, dynamic content rendering, and a complete CRUD flow — giving me hands-on experience with server-side development and relational databases.</p>
        <Link link="https://github.com/Marv0659/Web_dev_eksamen" text="Github!" />
      </div>
    </div>
  </section>

  <Whitespace size="small" />

  <section class="md:bg-slate-200 md:m-10 md:mx-40 md:p-3 md:rounded-md">
    <h2 class="text-center">Who am I?</h2>
    <div class="grid md:grid-cols-2 items-center">
      <div class="md:flex p-4 md:flex-col gap-1">
        <p class="">I'm a web developer with a bachelor's degree from KEA and professional experience from Black Lemon, a Shopify agency where I've built and maintained 30+ themes for brands like Intersport, Nordgreen and Organic Basics.</p>
        <p>I work across the full stack — from React and Next.js on the frontend to Python, Node.js and SQL databases on the backend. I'm comfortable with Docker, CI/CD pipelines and modern tooling, and I value clean, maintainable code.</p>
        <p>Outside of work, I stay active through football, running and strength training. I thrive in social settings where I can exchange ideas and learn from others.</p>
        <p>I approach new challenges with curiosity and a conviction that you can learn anything you set your mind to — an attitude that has served me well both professionally and personally.</p>
      </div>

      <div class="border-2 border-black rounded-md p-3 m-4 bg-white basis-1/2">
        <h2 class="text-center mb-4">Skills</h2>
        <p class="mb-4">Technologies that i have worked with:</p>
        <div class="grid grid-cols-3 gap-4">
          {
            skills.map((skill) => (
              <div class="flex flex-row items-center liItem">
                <div class="aspect-square bg-black w-2 h-2 mx-3" />
                <p>{skill}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Whitespace />

  <section class="text-center">
    <h2 class="text-2xl">What now</h2>
    <div class="grid place-self-center">
      <Image src={downloadGif} alt="Confused gif" />
    </div>
    <div class="m-4">
      <Link link="/cv.pdf" text="Download CV!" type="download" fileName="Frederik-Jensen-CV.pdf" />
      <Mail text="Send email!" />
    </div>
  </section>
</Mainlayout>

<Footer />

<script>
  import { inView, animate, stagger, spring } from "motion";

  window.addEventListener("load", addShadow);

  document.querySelector(".down").addEventListener("click", () => {
    document.querySelector(".projectText").scrollIntoView({ behavior: "smooth", block: "start" });
  });

  function addShadow() {
    setTimeout(() => {
      document.querySelector(".heroImg").classList.add("md:shadow-[-0.45rem_0.45rem_#121212]");
      document.querySelector(".heroImg").classList.add("shadow-[0.35rem_0.35rem_#121212]");
    }, 500);
  }

  animate(".aniHero", { y: ["100px", "0px"], opacity: [0, 1] }, { duration: 1 });

  animate(
    ".aniHeroText",
    {
      y: ["100px", "0px"],
      opacity: [0, 1],
    },
    {
      duration: 1.2,
    }
  );

  inView(".projectContainer", ({ target }) => {
    animate(".card_display", { y: ["400px", "0px"] }, { delay: stagger(0.1), easing: spring({ damping: 13 }) });
  });

  inView(".liItem", ({ target }) => {
    animate(".liItem", { opacity: [0, 1], scale: [0, 1] }, { delay: stagger(0.1), duration: 1 });
  });
</script>
